        <VBox>
            <HBox alignItems="Center">
                <Label text="성별" width="8em"/>
                <Input  id="gender"
                        placeholder="전체 / M / F"/>
            </HBox> 

            <HBox alignItems="Center">
                <Label text="최소 나이" width="8em"/>
                <Input  id="minAge"
                        placeholder="0~100"/>
            </HBox> 

