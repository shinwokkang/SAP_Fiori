<mvc:View 
    controllerName="code2.fiori.exam.exam2.controller.Exam_2"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:t="sap.ui.table"
	xmlns:m="sap.suite.ui.microchart"
    xmlns:viz="sap.viz.ui5.controls" 
    xmlns:viz.data="sap.viz.ui5.data" 
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    xmlns:layout="sap.ui.layout"
    xmlns="sap.m">
    
    <Page id="page" title="{i18n>title}">

    <!-- 11. 구구단을 출력하되 입력받은 숫자의 단은 Skip 하여 출력한다. -->

    <VBox>
        <HBox alignItems="Center">
        
            <Label  text="단 입력"
                    width="4em"/>
            <Input  id="iPassDan"
                    width="6em"/>
    
        </HBox>

        <Button text="구구단 출력"
                press=".onPrintGugudan"/>
    </VBox>



    <!-- 12. 구구단을 출력 하되 짝수단 만 출력 할것 -->
    
    <!-- onInit() 함수에 위의 JSON을 생성한다.
        버튼을 클릭하면 위의 배열의 모든 데이터를 console.log로 출력한다-->
    <VBox>
        <Button text="짝수 구구단 출력"
                press=".onTwinGuguDan"/>
    </VBox>


    <!-- 13. for 구문을 이용해서 위 aArray 를 console.log 로 출력 할것 -->
    <Button text="야구단 출력"
            press=".onPrintBaseballTeam"/>






    <!-- 14. 아래 데이터를 /ball/Base.json 파일로 생성한다 -->
    <!-- ball/Base.json 파일 데이터를 Import 하여 ui.Table 로 화면에 출력한다.-->
    <!-- Year, Area를 입력하는 SearchField를 View에 그리고 검색조건을 받아서 검색하는 기능 추가할것-->
        <VBox class="sapUiSmallMargin">
            <HBox alignItems="Center">
                <Label text="Year" width="4rem" />
                <Input id="iYear" width="9rem" placeholder="부분 검색" />
            </HBox>
            <HBox alignItems="Center">
                <Label text="Area" width="4rem" />
                <Input id="iArea" width="9rem" placeholder="부분 검색" />
            </HBox>
            
            <HBox>
                <Button text="검색" press=".onSearchBaseballTeams" />
            </HBox>
            
    <!-- Table 태그의 rows의 aggregation에 {Base>TeamSet} 배열을 줌으로써 해당 다중행을 순환하도록 한다.-->        
            <t:Table id="baseballTable" rows="{Base>/TeamSet}" selectionMode="None" width="100%">
            <t:columns>
                <t:Column>
                    <t:label>
                        <Label text="팀명" />
                    </t:label>
                    <t:template>
                        <Text text="{Base>Team}" />
                        </t:template>
                    </t:Column>
                    
                <t:Column>
                    <t:label>
                        <Label text="창단연도" />
                    </t:label>
                    <t:template>
                        <Text text="{Base>Year}" />
                        </t:template>
                    </t:Column>

                <t:Column>
                    <t:label>  
                        <Label text="연고지" />
                    </t:label>
                    <t:template>
                        <Text text="{Base>Area}" />
                    </t:template>
                </t:Column>
             
                <t:Column>
                    <t:label>
                        <Label text="우승횟수" />
                    </t:label>
                    <t:template>
                        <Text text="{Base>Win}" />
                    </t:template>
                </t:Column>
            
            </t:columns>
            
            </t:Table>
        </VBox>





        <!-- 15번 문제. -->
        <!-- 가로 정렬을 위해서 HBox 태그를 사용하여 FlexBox 태그를 내부에 둔다. -->
        <HBox>    

            <!-- InteractiveBarChart의 bars aggregation에 {populBorn>/popul} 배열 (다중행)을 줌으로써 해당 배열을 순환하도록 한다.-->
            <FlexBox width="20rem" height="15rem" alignItems="Center" class="sapUiSmallMargin">
                <items>
                    <m:InteractiveBarChart bars="{populBorn>/popul}" 
                        displayedBars="5" labelWidth="25%" >
                        <m:bars>
                            <m:InteractiveBarChartBar label="{populBorn>Year}" value="{populBorn>home}" displayedValue="{populBorn>home} 명"/>
                        </m:bars>
                    </m:InteractiveBarChart>
                </items>
            </FlexBox>

            <ToolbarSpacer width="6em"/>

            <!-- InteractiveBarChart의 segments aggregation에 {populBorn>/born} 배열 (다중행)을 줌으로써 해당 배열을 순환하도록 한다.-->
            <FlexBox width="20rem" height="10rem" alignItems="Start" justifyContent="SpaceBetween">
                <items>
                <m:InteractiveDonutChart segments="{populBorn>/born}" 
                        displayedSegments="5"
                        selectionChanged="onSelectionChanged">
                        <m:segments >
                            <m:InteractiveDonutChartSegment label="{populBorn>Year}" value="{populBorn>Birth}" displayedValue="{populBorn>Birth} 명"/>
                        </m:segments>
                    </m:InteractiveDonutChart>
                </items>
            </FlexBox>
        </HBox>



        <!-- 16. 아래의 JSON을 생성 후 vizFrame 으로 pie, Column, line 챠트 3개를 그릴 것
            title 안나오게 하고 plotArea는 'normal' 말고 다른걸로 해라-->

        <!-- 차트 공통 주석 -->
        <!--
        1. VizFrame클래스의 vizProperties 의 vizProperties 속성을 바꿈으로써 normal 에서 벗어나도록 했다. 
        2. VizFrame클래스의 vizProperties 의 title 속성에서 visible을 false로 둠으로써 title이 보이지 않도록 했다.
        3. FlattenedDataset 클래스의 data aggregation 으로 {companyGridSet>/GridSet} 배열 (다중행)을 줌으로써 순환하도록 하였다. 
        4. DimensionDefinition 클래스에서 Dimension은 Company Code로 선언하였으며,
             MeasureDefinition 클래스에서 Measure은 Fiscal year, Asset total 로 만들었다.-->

        <!-- pie -->
        <!-- VizFrame의 vizType = "pie" 를 줌으로써 파이 차트를 그리도록했다.-->
        <viz:VizFrame id="idVizFrame1" uiConfig="{applicationSet:'fiori'}"
            height="23em" width="40em" vizType="pie"
            vizProperties="{
                plotArea : { drawingEffect: 'glossy', background: 'border' },
                legend   : { drawingEffect: 'glossy' },
                title    : { 
                                text: 'Material Price Status', 
                                visible: false, 
                                style: { fontFamily: 'Helvetica'} 
                            }
            }"
            >
            <viz:dataset>
                <viz.data:FlattenedDataset data="{companyGridSet>/GridSet}">

                    <viz.data:dimensions>
                        <viz.data:DimensionDefinition name="Company code"
                            value="{companyGridSet>Bukrs}" />
                    </viz.data:dimensions>

                    <viz.data:measures>
                        <viz.data:MeasureDefinition name="Fiscal year"
                            value="{companyGridSet>Gjahr}" />
                    </viz.data:measures>

                    <viz.data:measures>
                        <viz.data:MeasureDefinition name="Asset total"
                            value="{companyGridSet>Anln1}" />
                    </viz.data:measures>

                </viz.data:FlattenedDataset>
            </viz:dataset>


            <viz:feeds>
                <viz.feeds:FeedItem uid="color" type="Dimension"
                    values="Company code" />

                <viz.feeds:FeedItem uid="size" type="Measure"
                    values="Fiscal year" />

                <viz.feeds:FeedItem uid="size" type="Measure"
                    values="Asset total" />


            </viz:feeds>
            <viz:dependents>
                <viz:Popover id="idPopOver1"></viz:Popover>
            </viz:dependents>
        </viz:VizFrame>

        <ToolbarSpacer width="6em"/>


        <!-- column -->
        <viz:VizFrame id="idVizFrame" uiConfig="{applicationSet:'fiori'}"
            height="23em" width="40em" vizType='column'
            vizProperties="{
                plotArea : { drawingEffect: 'glossy' },
                legend   : { drawingEffect: 'glossy' },
                title    : { 
                        text: 'Material Price Status', 
                        visible: false, 
                        style: { fontFamily: 'Helvetica'} 
                    }
            }">
            <viz:dataset>
                <viz.data:FlattenedDataset data="{companyGridSet>/GridSet}">
                    <viz.data:dimensions>
                        <viz.data:DimensionDefinition name="Company code"
                            value="{companyGridSet>Bukrs}" />
                    </viz.data:dimensions>
                    <viz.data:measures>
                        <viz.data:MeasureDefinition name="Fiscal year"
                            value="{companyGridSet>Gjahr}" />
                        <viz.data:MeasureDefinition name="Asset total"
                            value="{companyGridSet>Anln1}" />
                    </viz.data:measures>
                </viz.data:FlattenedDataset>
            </viz:dataset>

            <viz:feeds>
                <viz.feeds:FeedItem id='categoryAxisFeed' uid="categoryAxis" type="Dimension"
                    values="Company code" />
                <viz.feeds:FeedItem id='valueAxisFeed' uid="valueAxis" type="Measure"
                    values="Fiscal year" />
                <viz.feeds:FeedItem id='valueAxisFeed2' uid="valueAxis" type="Measure"
                    values="Asset total" />
            </viz:feeds>
            <viz:dependents>
                <viz:Popover id="idPopOver"></viz:Popover>
            </viz:dependents>
        </viz:VizFrame>


        <!-- line -->
        <viz:VizFrame uiConfig="{applicationSet:'fiori'}"
            height="23em" width="40em" vizType='line'
            vizProperties="{
                plotArea : { drawingEffect: 'glossy' },
                legend   : { drawingEffect: 'glossy' },
                title    : { 
                        text: 'Material Price Status', 
                        visible: false, 
                        style: { fontFamily: 'Helvetica'} 
                    }
            }">
            <viz:dataset>
                <viz.data:FlattenedDataset data="{companyGridSet>/GridSet}">
                    <viz.data:dimensions>
                        <viz.data:DimensionDefinition name="Company code"
                            value="{companyGridSet>Bukrs}" />
                    </viz.data:dimensions>
                    <viz.data:measures>
                        <viz.data:MeasureDefinition name="Fiscal year"
                            value="{companyGridSet>Gjahr}" />
                        <viz.data:MeasureDefinition name="Asset total"
                            value="{companyGridSet>Anln1}" />
                    </viz.data:measures>
                </viz.data:FlattenedDataset>
            </viz:dataset>

            <viz:feeds>
                <viz.feeds:FeedItem uid="categoryAxis" type="Dimension"
                    values="Company code" />
                <viz.feeds:FeedItem uid="valueAxis" type="Measure"
                    values="Fiscal year" />
                <viz.feeds:FeedItem uid="valueAxis" type="Measure"
                    values="Asset total" />
            </viz:feeds>
            <viz:dependents>
                <viz:Popover></viz:Popover>
            </viz:dependents>
        </viz:VizFrame>

    </Page>

</mvc:View>