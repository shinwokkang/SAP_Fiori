<mvc:View 
    controllerName="code2.fiori.grid02.code2fiorigrid02.controller.Grid02View"
    xmlns:t="sap.ui.table"
	xmlns:mvc="sap.ui.core.mvc"
    xmlns:u="sap.ui.unified"
    xmlns:l="sap/ui/core/library"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">

<!-- ✏️ 고침(10/30): paste="onPaste"를 뺐어요. 컨트롤러에 onPaste 함수가 없어서 [FUTURE FATAL] 경고가 나요.
     내 코드: ariaLabelledBy="title" paste="onPaste"> -->
<t:Table
            id="countrySet"
            rows="{/countrySet}"
            selectionMode="Single"
            selectionBehavior="RowOnly"
            ariaLabelledBy="title">
   
            <t:extension>
                <OverflowToolbar style="Clear">
                    <Label text="국가" design="Bold"/>
                    <Input id="ICountry" width="8em" placeholder="국가명" showClearIcon="true"/>

                    <ToolbarSpacer width="3em"/>

                    <Label text="Area" design="Bold"/>
                    <Input id="IArea" width="8em" placeholder="수도명" showClearIcon="true"/>
                  
                    <Button text="Search" icon="sap-icon://search" width="10em" press=".onSearch"/>
                </OverflowToolbar>
            </t:extension>
   
            <t:columns>
                <t:Column width="8rem">
                    <Label text="Country Name" />
                    <t:template>
                        <Text text="{Country}" wrapping="false" />
                    </t:template>
                </t:Column>   

                <t:Column width="9rem">
                    <Label text="Country Capital" />
                    <t:template>
                        <Text text="{Capital}" wrapping="false" />
                    </t:template>
                </t:Column>       
                
                <t:Column width="10rem">
                    <Label text="Country Area" />
                    <t:template>
                        <Text text="{Area}" wrapping="false"/>
                    </t:template>
                </t:Column>           
            </t:columns>

            
        </t:Table>













        <!-- ✏️ 고침(10/30): paste="onPaste"를 뺐고(위 표와 같은 이유), ariaLabelledBy를 이 표의 제목 id인 title1로 바꿨어요.
             내 코드: ariaLabelledBy="title" paste="onPaste"> -->
    	<t:Table
            id = "materialSet"
            rows="{Mat>/gt_steel}"
            selectionMode="MultiToggle"
            selectionBehavior="RowSelector"
            ariaLabelledBy="title1">
   
            <t:extension>
                <OverflowToolbar style="Clear">
                    <Title id="title1" text="Material Set"/>
              
                    <Label text="국가" design="Bold"/>
                    <Input id="IMatnr" width="8em" placeholder="Matnr" showClearIcon="true"/>

                    <ToolbarSpacer width="3em"/>

                    <Label text="Netprice" design="Bold"/>
                    <Input id="INetprice" type="Number" width="8em" placeholder="Netprice" showClearIcon="true"/>

                    <Button text="Search" icon="sap-icon://search" width="10em" press=".onSearch2"/>                    
                </OverflowToolbar>
            </t:extension>
   
            <t:columns>
                <t:Column width="6rem">
                    <Label text="material" />
                    <t:template>
                        <Text text="{Mat>Matnr}" wrapping="false" />
                    </t:template>
                </t:Column>             
            </t:columns>

            <t:columns>
                <t:Column width="8rem">
                    <Label text="Mat.Desc" />
                    <t:template>
                        <Text text="{Mat>Maktx}" wrapping="false" />
                    </t:template>
                </t:Column>             
            </t:columns>

            <t:columns>
                <t:Column width="8rem">
                    <Label text="Plant" />
                    <t:template>
                        <Text text="{Mat>Werks}" wrapping="false"/>
                    </t:template>
                </t:Column>             
            </t:columns>

            <t:columns>
                <t:Column width="8rem">
                    <Label text="Net Price" />
						<t:template>
							<!-- <u:Currency value="{Mat>Netprice}" currency="{Mat>Curr}"/> -->
						<Text text="{
                            parts:[{path:'Mat>Netprice'},{path:'Mat>Curr'}],
                            type: 'sap.ui.model.type.Currency',
                            formatOptions: {showMeasure: true }
                            }" wrapping="false" />

                        </t:template>
                </t:Column>             
            </t:columns>

            <t:columns>
                <t:Column width="8rem">
                    <Label text="Net Price" />
						<t:template>
							<u:Currency value="{Mat>Netprice}" currency="{Mat>Curr}"/>
                        </t:template>
                </t:Column>             
            </t:columns>

            <!-- <t:columns>
                <t:Column width="8rem">
                    <Label text="Currency" />
                    <t:template>
                        <Text text="{Mat>Curr}" wrapping="false" />
                    </t:template>
                </t:Column>             
            </t:columns> -->

        </t:Table>       





    </Page>
</mvc:View>


<!--
실무에서는 이전 내 소스를 복붙함.
해당 회사에 맞는 로직만 작성하고, 내가 가지고 있는 소스를 붙여넣음. 
그래서 개발자의 재산은 Source임.

-->