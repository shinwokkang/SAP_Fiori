<mvc:View 
    controllerName="code2.fiori.edu02.code2fioriedu02.controller.Edu02View"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">

    <!-- VBox는 아래로 쭈욱 HBox는 옆으로 쭈욱.-->



        <VBox> 
            <HBox>
                <Text text="{/Study/Lecture}" width="{/Study/Width}" />
                <Text text="  {/Study/Class}" width="{/Study/Width}"/>

            </HBox>
            <HBox>
                <Label text="{/Infor/Name}"   design="{/Infor/Design}"/>
                <Label text="{/Infor/Number}" design="{/Infor/Design}"/>

            </HBox>

            <!-- Prop 이라는 방을 따로 만들었다면 주소는 "Prop>"" 을 사용함.
            이거 기억하자 .. -->
            <HBox>
                <Input 
                    width = "{Prop>/Input/Width}"
                    placeholder="{Prop>/Input/PlaceHolder}"
                    showClearIcon="{Prop>/Input/ShowClearIcon}"
                    description="{Prop>/Input/Description}"/> <!-- Name Input Field가 나오도록 하기 실습.-->
            </HBox>


            <!-- 실습 -->

            <HBox>
                <Text
                    id = "TxT1"
                    text="오늘은 코드2기 2주차"
                    width="{Text>/Width}" 
                    textAlign="Begin"/>   
            </HBox>

            <HBox
                justifyContent="Center">

                <!-- <Button 
                        text="Begin"
                        press=".onPressBegin"/>      
                <Button 
                        text="Center"
                        press=".onPressCenter"/>   
                <Button 
                        text="Right"
                        press=".onPressRight"/>    -->
            
                <Button 
                        text="Begin"
                        press='.onPressBegin("Begin")'/>      
                <Button 
                        text="Center"
                        press=".onPressCenter('Center')"/>   
                <Button 
                        text="Right"
                        press=".onPressRight('Right')"/>   
            
            
            
            </HBox>

            <Label 
                id="Lab1"
                text="다음주 회식"
                design="Bold"
                width="{Input>/Width}"/>
            <Input 
                id="Inp1"
                placeholder="{Input>/PlaceHolder}"
                width="{Input>/Width}"
                liveChange=".onLiveChange"
                />
            <Button 
                text="문자열 바꾸기"
                press=".onChangeValue"/>

        </VBox>

        <VBox>

            <Text 
                text="SAP Code2 Class 1"/>
            <Text 
                text="Class 1 본인이름"/>
            <Label 
                text="구로디지털단지 2번 출구"/>
            <Label 
                text="걸어서 10분거리"
                design = "Bold"/>
        </VBox>

        <VBox>
            <VBox
                justifyContent="Center"
                fitContainer="true"
                width="40em">


                <HBox
                    width="100%">
                    <Label text="ID"/>
                    <Input />
                </HBox>
            <HBox>
                <Label text="Name"/>
                <Input />                            
            </HBox>
            <HBox>
                <Label text="Age" />
                <Input id = "iNum"
                        type="Number" 
                        liveChange=".onDetectChange" />            
            </HBox>
            </VBox>

            <Input
                width="10em"
                placeholder="Address"
                showClearIcon="true"/>
            
            <HBox>

            <Input
                width="10em"
                placeholder="Hobby"/>
            <Text text="please write only one hobby."/>

            </HBox>
            
        </VBox>


        <VBox >
            <Text text="SAP Code2 Class1 Fiori Text"
                  width="200px"
                  textAlign="Center"/>
            
            <Label text="Class 1 Fighting"
                    width="20rem"
                    design="Bold"/>
            
            <Button text="Airline"
                    icon="sap-icon://travel-itinerary"/>

            <Button id="iAirBellButton"
                    text="Bell"
                    icon="sap-icon://bell"
                    press=".onAlertName"
                    width="100px"/>

            <Button id="iSettingButton"
                    text="Setting"
                    icon="sap-icon://action-settings"
                    press=".onAlretSetting"
                    width="30em" />
        </VBox>



        <VBox >
                <Input  id="iNum1"
                        placeholder="1st Number"
                        width="20em"
                        type="Number"
                        showClearIcon="true"/>

                <Input  id="iNum2"
                        placeholder="2nd Number"
                        width="20em"
                        type="Number"
                        showClearIcon="true"/>

                <Input  id="iNumResult"
                        placeholder="Result"
                        width="20em"
                        type="Number"
                        showClearIcon="true"
                        />

                <Button text="계산"
                        press=".onCalNum"/>
        </VBox>

        <VBox >
            <Input  id="iBase"
                    width="20em"
                    placeholder="밑변"
                    showClearIcon="true"/>
            <Input id="iTWidth"
                    width="20em"
                    placeholder="높이"
                    showClearIcon="true"/>
            <Input  id = "iTriResult"
                    width="20em"
                    placeholder="삼각형 넓이"
                    showClearIcon="true"/>
            <Button text="계산"
                    press=".onTriCal"/>
        </VBox>        



        <VBox >
            <HBox 
                width="15em"
                alignContent="Center"
                alignItems="Center"
                justifyContent="SpaceBetween"            >
                <Text  
                        text="물건값"/>
                <Input  id="iProduct"/>
            </HBox>
            <HBox >
                <Text   width="20em"
                        text="할인율"/>
                <Input  id="iDiscount"/>            
            </HBox>
            <HBox >
                <Text   width="20em"
                        text="할인된값"/>
                <Input  id="iPrice"/>
            </HBox>
            <Button text="계산"
                    press=".onRateToPrice"/>
        </VBox>

        <VBox >
            <HBox >
                <Text   width="20em"
                        text="물건값"/>
                <Input  id="iProduct2"/>
            </HBox>
            <HBox >
                <Text   width="20em"
                        text="지불한값"/>
                <Input  id="iPay"/>            
            </HBox>
            <HBox >
                <Text   width="20em"
                        text="할인율"/>
                <Input  id="iRate"/>
            </HBox>
            <Button text="계산"
                    press=".onPriceToRate"/>
        </VBox>



        
    </Page>
</mvc:View>